# Ver .env.example en la raiz del repo: en local, docker-compose.yml
# inyecta estas mismas variables al contenedor de la API.
# Este fichero es solo de referencia para ejecutar la API suelta (npm run dev).

NODE_ENV=development
API_PORT=4000
# Zona horaria de la tienda: horario de apertura, horas de recogida y fechas exportadas
STORE_TIME_ZONE=America/Bogota
MONGO_URI=mongodb://localhost:27017/laquinta
REDIS_URL=redis://localhost:6379
JWT_SECRET=cambia-esto-en-desarrollo-tambien
JWT_EXPIRES_IN=30d
OTP_TTL_SECONDS=300
OTP_CHANNEL=email

# --- Exportacion de pedidos entregados y cancelados a Google Sheets (opcional) ---
# 1. En Google Cloud: habilita "Google Sheets API" y crea una cuenta de servicio con una clave JSON.
# 2. Comparte la hoja de calculo con el email de la cuenta de servicio (permiso de Editor).
# 3. El ID de la hoja es la parte de la URL entre /d/ y /edit.
# La clave privada va en una sola linea, entre comillas, con los saltos como \n (tal cual viene en el JSON).
# Si faltan estas variables, los pedidos se quedan en cola y se exportan cuando se configuren.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Pedidos
GOOGLE_SHEETS_CANCELLED_TAB=Cancelados
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
