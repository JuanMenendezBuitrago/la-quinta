{
  "name": "la-quinta-api",
  "version": "0.1.0",
  "private": true,
  "description": "API GraphQL de La Quinta (monolito modular: carta, pedidos, fidelizacion, usuarios)",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "ts-node-dev --transpile-only --exit-child src/scripts/seed.ts",
    "import-menu": "ts-node-dev --transpile-only --exit-child src/scripts/import-menu.ts",
    "export-sheets": "ts-node-dev --transpile-only --exit-child src/scripts/export-orders-to-sheets.ts",
    "recalc-stock": "ts-node-dev --transpile-only --exit-child src/scripts/recalc-stock.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/merge": "^9.0.7",
    "@graphql-tools/schema": "^10.0.6",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.1",
    "graphql": "^16.9.0",
    "graphql-redis-subscriptions": "^2.6.1",
    "graphql-subscriptions": "^2.0.0",
    "graphql-ws": "^5.16.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.15",
    "@types/ws": "^8.5.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
