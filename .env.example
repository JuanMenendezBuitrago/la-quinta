# Copia este fichero a .env y ajusta los valores antes de levantar docker compose.

# --- General ---
NODE_ENV=development
DOMAIN=localhost
# Zona horaria de la tienda: horario de apertura, horas de recogida y fechas exportadas
STORE_TIME_ZONE=America/Bogota

# --- API ---
API_PORT=4000
MONGO_URI=mongodb://mongo:27017/laquinta
REDIS_URL=redis://redis:6379
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=30d
OTP_TTL_SECONDS=300
OTP_CHANNEL=email
# Necesario solo si OTP_CHANNEL=email
SMTP_URL=
# Remitente de los correos (codigo de acceso y novedades)
SMTP_FROM="La Quinta <hola@example.com>"
# Direccion publica de la web, para los enlaces de los correos (darse de baja de las novedades)
PUBLIC_SITE_URL=http://localhost:3000
# Necesario solo si OTP_CHANNEL=sms
SMS_PROVIDER_API_KEY=

# --- Exportacion de pedidos entregados y cancelados a Google Sheets (opcional) ---
# 1. En Google Cloud: habilita "Google Sheets API" y crea una cuenta de servicio con una clave JSON.
# 2. Comparte la hoja de calculo con el email de la cuenta de servicio (permiso de Editor).
# 3. El ID de la hoja es la parte de la URL entre /d/ y /edit.
# La clave privada va en una sola linea, entre comillas, con los saltos como \n (tal cual viene en el JSON).
# Si faltan estas variables, los pedidos se quedan en cola y se exportan cuando se configuren.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Pedidos
GOOGLE_SHEETS_CANCELLED_TAB=Cancelados
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Web (Nuxt) ---
WEB_PORT=3000
NUXT_PUBLIC_GRAPHQL_HTTP=http://localhost:4000/graphql
NUXT_PUBLIC_GRAPHQL_WS=ws://localhost:4000/graphql

# --- Mongo ---
MONGO_INITDB_DATABASE=laquinta
